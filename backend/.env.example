# Set these on the backend process, never as VITE_ variables.
RELAY_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Public deployment requires an access code (not the model API key).
RELAY_REQUIRE_ACCESS=1
RELAY_ACCESS_CODE=
RELAY_MODEL=qwen-vl-max
DASHSCOPE_API_KEY=
# Optional OpenAI-compatible local vision model endpoint instead of DashScope:
RELAY_MODEL_SERVER=
RELAY_MODEL_API_KEY=
RELAY_OCR_ENABLED=0
RELAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional public-web price search. Never expose this key in VITE_ variables.
TAVILY_API_KEY=

# Optional database and private image storage. Set only on the backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=item-images
